<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TrimFetch.Controls.TrimTimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinHeight="64"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TimelineThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Border
                                Background="#FFFFD60A"
                                CornerRadius="8"
                                BorderBrush="#FFFFE66D"
                                BorderThickness="1" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="3">
                                <Rectangle Width="1.5" Height="20" RadiusX="1" RadiusY="1" Fill="#AA000000" />
                                <Rectangle Width="1.5" Height="20" RadiusX="1" RadiusY="1" Fill="#AA000000" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="ClipHost"
        MinHeight="64"
        SizeChanged="ClipHost_SizeChanged">
        <Canvas
            x:Name="TimelineCanvas"
            Height="64"
            HorizontalAlignment="Stretch"
            SizeChanged="TimelineCanvas_SizeChanged">
        <Border
            x:Name="TrackBackground"
            Canvas.Left="0"
            Canvas.Top="0"
            Height="64"
            Background="#99000000"
            CornerRadius="12" />
        <Border
            x:Name="FilmstripClip"
            Canvas.Left="4"
            Canvas.Top="8"
            Height="48"
            CornerRadius="8"
            IsHitTestVisible="False">
            <Grid Background="#FF101010">
                <Grid x:Name="FilmstripHost" />
                <Canvas x:Name="WaveformCanvas" Visibility="Collapsed" />
            </Grid>
        </Border>
        <Rectangle
            x:Name="LeftDim"
            Canvas.Left="0"
            Canvas.Top="0"
            Fill="#77000000"
            Height="64" />
        <Rectangle
            x:Name="RightDim"
            Canvas.Top="0"
            Fill="#77000000"
            Height="64" />
        <Border
            x:Name="SelectionFrame"
            Canvas.Top="0"
            Height="64"
            BorderBrush="#FFFFD60A"
            BorderThickness="4"
            CornerRadius="12"
            IsHitTestVisible="False" />
        <Border
            x:Name="SeekTarget"
            Canvas.Top="0"
            Height="64"
            Background="Transparent"
            PointerEntered="SeekTarget_PointerEntered"
            PointerExited="SeekTarget_PointerExited"
            PointerPressed="SeekTarget_PointerPressed" />
        <Thumb
            x:Name="StartThumb"
            Canvas.Top="0"
            Width="22"
            Height="64"
            AutomationProperties.Name="Trim start"
            DragCompleted="StartThumb_DragCompleted"
            DragDelta="StartThumb_DragDelta"
            Style="{StaticResource TimelineThumbStyle}" />
        <Thumb
            x:Name="EndThumb"
            Canvas.Top="0"
            Width="22"
            Height="64"
            AutomationProperties.Name="Trim end"
            DragCompleted="EndThumb_DragCompleted"
            DragDelta="EndThumb_DragDelta"
            Style="{StaticResource TimelineThumbStyle}" />
        <Rectangle
            x:Name="Playhead"
            Canvas.Top="4"
            Width="3"
            Height="56"
            Fill="#FFFFD60A"
            IsHitTestVisible="False"
            RadiusX="1.5"
            RadiusY="1.5"
            Visibility="Collapsed" />
        </Canvas>
    </Grid>
</UserControl>
