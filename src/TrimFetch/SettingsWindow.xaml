<?xml version="1.0" encoding="utf-8"?>

<Window

    x:Class="TrimFetch.SettingsWindow"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:local="using:TrimFetch"

    Title="Settings">



    <Grid x:Name="RootGrid" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent"
            Canvas.ZIndex="1" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">

            <StackPanel Padding="48,12,48,32" Spacing="0" MaxWidth="560">

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="TrimFetch" />
                <TextBlock
                    Margin="0,2,0,28"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />

                <TextBlock
                    Margin="0,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Downloads" />
                <TextBlock
                    Margin="0,2,0,10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Where files are saved and how they are downloaded."
                    TextWrapping="Wrap" />

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Download folder" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.DownloadFolderPath, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind ViewModel.DownloadFolderPath, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{x:Bind ViewModel.ChooseDownloadFolderCommand}"
                                    Content="Change folder"
                                    Style="{StaticResource DefaultButtonStyle}" />
                                <Button
                                    Command="{x:Bind ViewModel.OpenDownloadFolderCommand}"
                                    Content="Open folder"
                                    Style="{StaticResource DefaultButtonStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Opacity="0.55" />

                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Default download quality" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind ViewModel.DownloadQualityOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedDownloadQualityOption, Mode=TwoWay}" />
                        </StackPanel>

                        <Border
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Opacity="0.55" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Auto-download from clipboard" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="When a supported video link is copied, download it automatically."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.AutoDownloadClipboardUrls, Mode=TwoWay}"
                                OffContent=""
                                OnContent=""
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,28,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Background" />
                <TextBlock
                    Margin="0,2,0,10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Keep TrimFetch available while you work in other apps."
                    TextWrapping="Wrap" />

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Run at startup" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Launch TrimFetch when you sign in to Windows."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}"
                                OffContent=""
                                OnContent=""
                                VerticalAlignment="Center" />
                        </Grid>

                        <Border
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Opacity="0.55" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Download notifications" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Show a native Windows toast with the video preview when a download finishes."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.ShowDownloadNotifications, Mode=TwoWay}"
                                OffContent=""
                                OnContent=""
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock
                    Margin="0,28,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Video tools" />

                <TextBlock

                    Margin="0,2,0,10"

                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                    Style="{StaticResource CaptionTextBlockStyle}"

                    Text="Required for downloading and trimming videos."

                    TextWrapping="Wrap" />



                <Border

                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                    BorderThickness="1"

                    CornerRadius="8">

                    <StackPanel Spacing="0">

                        <Grid MinHeight="56" Padding="16,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">

                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="yt-dlp" />

                                <TextBlock

                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                                    Style="{StaticResource CaptionTextBlockStyle}"

                                    Text="{x:Bind ViewModel.YtDlpStatusText, Mode=OneWay}" />

                            </StackPanel>

                            <FontIcon

                                Grid.Column="1"

                                VerticalAlignment="Center"

                                FontFamily="{ThemeResource SymbolThemeFontFamily}"

                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"

                                Glyph="&#xE73E;"

                                Visibility="{x:Bind local:SettingsWindow.BoolToVisibility(ViewModel.HasYtDlp), Mode=OneWay}" />

                            <Button

                                Grid.Column="1"

                                MinWidth="88"

                                Command="{x:Bind ViewModel.InstallYtDlpCommand}"

                                Style="{StaticResource AccentButtonStyle}"

                                Visibility="{x:Bind local:SettingsWindow.InverseBoolToVisibility(ViewModel.HasYtDlp), Mode=OneWay}">

                                <StackPanel Orientation="Horizontal" Spacing="8">

                                    <ProgressRing

                                        Width="14"

                                        Height="14"

                                        IsActive="{x:Bind ViewModel.IsInstallingYtDlp, Mode=OneWay}" />

                                    <TextBlock Text="Install" />

                                </StackPanel>

                            </Button>

                        </Grid>



                        <Border

                            Height="1"

                            Margin="16,0"

                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"

                            Opacity="0.55" />



                        <Grid MinHeight="56" Padding="16,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">

                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ffmpeg" />

                                <TextBlock

                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                                    Style="{StaticResource CaptionTextBlockStyle}"

                                    Text="{x:Bind ViewModel.FfmpegStatusText, Mode=OneWay}" />

                            </StackPanel>

                            <FontIcon

                                Grid.Column="1"

                                VerticalAlignment="Center"

                                FontFamily="{ThemeResource SymbolThemeFontFamily}"

                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"

                                Glyph="&#xE73E;"

                                Visibility="{x:Bind local:SettingsWindow.BoolToVisibility(ViewModel.HasFfmpeg), Mode=OneWay}" />

                            <Button

                                Grid.Column="1"

                                MinWidth="88"

                                Command="{x:Bind ViewModel.InstallFfmpegCommand}"

                                Style="{StaticResource AccentButtonStyle}"

                                Visibility="{x:Bind local:SettingsWindow.InverseBoolToVisibility(ViewModel.HasFfmpeg), Mode=OneWay}">

                                <StackPanel Orientation="Horizontal" Spacing="8">

                                    <ProgressRing

                                        Width="14"

                                        Height="14"

                                        IsActive="{x:Bind ViewModel.IsInstallingFfmpeg, Mode=OneWay}" />

                                    <TextBlock Text="Install" />

                                </StackPanel>

                            </Button>

                        </Grid>

                    </StackPanel>

                </Border>



                <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="12">

                    <Button

                        Command="{x:Bind ViewModel.RefreshToolsCommand}"

                        Content="Verify installation"

                        Style="{StaticResource DefaultButtonStyle}" />

                    <ProgressRing

                        Width="20"

                        Height="20"

                        IsActive="{x:Bind ViewModel.IsRefreshingTools, Mode=OneWay}"

                        Visibility="{x:Bind local:SettingsWindow.BoolToVisibility(ViewModel.IsRefreshingTools), Mode=OneWay}" />

                </StackPanel>



                <TextBlock

                    Margin="0,8,0,0"

                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                    Style="{StaticResource CaptionTextBlockStyle}"

                    Text="{x:Bind ViewModel.ToolsStatusMessage, Mode=OneWay}"

                    TextWrapping="Wrap"

                    Visibility="{x:Bind local:SettingsWindow.StringToVisibility(ViewModel.ToolsStatusMessage), Mode=OneWay}" />



                <TextBlock

                    Margin="0,28,0,0"

                    Style="{StaticResource BodyStrongTextBlockStyle}"

                    Text="About" />

                <TextBlock

                    Margin="0,2,0,10"

                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                    Style="{StaticResource CaptionTextBlockStyle}"

                    Text="Version, updates, and developer." />



                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                x:Name="AboutAppIcon"
                                Width="40"
                                Height="40" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="TrimFetch" />
                                <TextBlock
                                    x:Name="ProductNameText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="TrimFetch Media Downloader" />
                                <TextBlock
                                    x:Name="VersionText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CheckForUpdates_Click"
                                Content="Check for updates"
                                Style="{StaticResource DefaultButtonStyle}" />
                        </Grid>

                        <Border
                            Height="1"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Opacity="0.55" />

                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Developer" />
                            <HyperlinkButton
                                Content="Zied Kallel"
                                NavigateUri="https://github.com/zioder"
                                Padding="0"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <Button
                            Click="Donate_Click"
                            Content="Buy me a coffee"
                            HorizontalAlignment="Left"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>



                <TextBlock

                    Margin="0,28,0,0"

                    Style="{StaticResource BodyStrongTextBlockStyle}"

                    Text="Keyboard shortcuts" />

                <TextBlock

                    Margin="0,2,0,10"

                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                    Style="{StaticResource CaptionTextBlockStyle}"

                    Text="Press a shortcut button, then press the new key combination. Escape cancels. Activate app works globally."

                    TextWrapping="Wrap" />



                <Border

                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                    BorderThickness="1"

                    CornerRadius="8"

                    Padding="12,4">

                    <StackPanel x:Name="ShortcutRows" Spacing="0" />

                </Border>



            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>


