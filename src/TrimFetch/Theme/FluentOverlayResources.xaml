<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:TrimFetch.Converters"
    xmlns:media="using:Microsoft.UI.Xaml.Media">

    <converters:ThumbnailPathConverter x:Key="ThumbnailPathConverter" />
    <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
    <converters:CopiedItemGlyphConverter x:Key="CopiedItemGlyphConverter" />

    <!-- Transparent at rest; OverlayGlass applies borders when Mica is active. -->
    <SolidColorBrush x:Key="OverlayCardFillBrush" Color="Transparent" />
    <StaticResource x:Key="OverlayCardInactiveFillBrush" ResourceKey="ControlFillColorDefaultBrush" />
    <SolidColorBrush x:Key="OverlayCardStrokeBrush" Color="#55FFFFFF" />

    <x:Double x:Key="OverlayContentWidth">680</x:Double>
    <!-- 16:9 trim preview frame (width matches OverlayContentWidth). -->
    <x:Double x:Key="OverlayTrimVideoHeight">382.5</x:Double>
    <x:Double x:Key="OverlaySectionGap">16</x:Double>
    <x:Double x:Key="OverlayInputHeight">64</x:Double>

    <Style x:Key="OverlayInputChromeStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource OverlayContentWidth}" />
        <Setter Property="Height" Value="{StaticResource OverlayInputHeight}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource OverlayCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OverlayCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
    </Style>

    <Style x:Key="OverlaySectionCardStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource OverlayContentWidth}" />
        <Setter Property="Background" Value="{StaticResource OverlayCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayHistoryCardStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource OverlayContentWidth}" />
        <Setter Property="Background" Value="{StaticResource OverlayCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8,16,8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayStatusPillStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="OverlayUrlTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource SystemAccentColor}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="OverlayIconButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="HistoryIconButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <SolidColorBrush x:Key="OverlayVideoStrokeBrush" Color="#1AFFFFFF" />
</ResourceDictionary>
